# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
SCORING_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+psycopg://astro:astro@postgres:5432/astro_window
# RUN_DB_INIT=auto  # 1=always migrate/seed, 0=never, unset=skip when command is celery

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth / email
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Astro Window <noreply@local.test>
FRONTEND_BASE_URL=http://localhost:8080
SESSION_COOKIE_NAME=astro_session
SESSION_COOKIE_SECURE=false

# Weather
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
POSTCODES_IO_BASE_URL=https://api.postcodes.io
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_STALE_TTL_SECONDS=7200
WEATHER_REQUEST_TIMEOUT_SECONDS=10
GEOCODING_REQUEST_TIMEOUT_SECONDS=8
GEOCODING_CACHE_TTL_SECONDS=86400

# Rate limiting
FORECAST_RATE_LIMIT_PER_MINUTE=60
GEOCODING_RATE_LIMIT_PER_MINUTE=30

# Frontend (bake at image build)
VITE_API_BASE_URL=/api/v1
